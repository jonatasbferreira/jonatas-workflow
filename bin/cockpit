#!/bin/bash
export LC_ALL=C.UTF-8
data="${MAESTRI_DATA_DIR:-$HOME/.maestri}"
state="${XDG_STATE_HOME:-$HOME/.local/state}/jonatas-workflow/cockpit"
claude_dirs="${COCKPIT_CLAUDE_DIRS:-$HOME/.claude:$HOME/.claude-rea:$HOME/.claude-personal}"
proc_dir="${COCKPIT_PROC_DIR:-/proc}"
codex_dir="${COCKPIT_CODEX_DIR:-$HOME/.codex/sessions}"
rounds_dir="$state/rounds"
ROUND_STALE_SECONDS=600
declare -A procs=()

KNOWN='def known: if . == null or . == "" or test("\t") then "?" elif . == "-" then "—" elif test("^[0-9]+$") then tonumber else . end;'
MANIFEST='
def TICKET: "#[0-9]+|[A-Z]+-[0-9]+";
def ticket_at($re): [capture($re)][0];
def manifest_item: (.d // "") as $d
  | {ticket: .t,
     is_parent: ($d | startswith("parent")),
     leaves: ($d | ticket_at("(?<n>[0-9]+) leaves?").n | if . then tonumber else null end),
     parent: ($d | ticket_at("leaf of (?<p>\(TICKET))").p),
     blocked: [$d | ticket_at("blocked by (?<b>.*)$").b // "" | scan(TICKET)]};
def manifest:
  (split("\n") | map(rtrimstr("\r"))) as $lines
  | (first($lines | to_entries[] | select(.value | test("^round · [0-9]{4}-[0-9]{2}-[0-9]{2}")) | .key) // null) as $start
  | if $start == null or any($lines[]; . == "(no round open)") then null else
      {date: ($lines[$start] | capture("^round · (?<d>[0-9-]+)").d),
       items: (reduce $lines[$start + 1:][] as $line ({list: [], open: true};
         if .open then
           ($line | ticket_at("^[0-9]+\\. (?<t>\(TICKET))(?: \\((?<d>[^)]*)\\))?")) as $m
           | if $m then .list += [$m | manifest_item]
             elif ($line | test("^\\s*$")) or (.list | length) == 0 then .
             else .open = false end
         else . end) | .list)}
    end;'
ROUND="$KNOWN$MANIFEST"'
def distinct(f): reduce .[] as $x ([]; if any(.[]; f == ($x | f)) then . else . + [$x] end);
def merged_tickets:
  reduce .[] as $x ([];
    (map(.ticket) | index($x.ticket)) as $at
    | if $at == null then . + [$x]
      else .[$at] |= (.blocked += $x.blocked | .inherited = ((.inherited // []) + ($x.inherited // [])) | .parent //= $x.parent) end);
def slices:
  split("\n") | map(select(. != "") | split("\u001f"))
  | map(.[1] as $label
    | ($label | ticket_at("^(?<p>\(TICKET))/(?<c>.+)$")) as $path
    | ($path != null and ($path.c | test("^(\(TICKET))$"))) as $numbered
    | (if $numbered then $path.c else $label end) as $ticket
    | {ticket: $ticket, base: (if $path != null and ($numbered | not) then $path.p else $ticket | split(" ")[0] end), parent: $path.p, executor: .[0], state: .[2],
       model: (.[3] | known), points: (.[4] | known), step: (.[5] | known)});
($cached[0] // {}) as $cache
| def issue($t): $cache.issues[$t] // {};
  ($note | manifest) as $m
  | ($lines | slices) as $board
  | select($m != null and ($m.items | length) > 0)
  | ($m.items | map(. as $e
      | if .is_parent then
          (issue($e.ticket).leaves // [])
          | map({ticket: ., parent: $e.ticket, blocked: $e.blocked, inherited: (issue($e.ticket).blockers // [])})
        else [$e] end) | add | merged_tickets) as $tickets
  | ($board | map(. as $s | select(all($tickets[]; .ticket != $s.base) and all($m.items[]; (.is_parent and .ticket == $s.ticket) | not)))) as $unlisted
  | def still_open($b):
      [$board[] | select(.base == $b.ticket)] as $own
      | if ($own | length) > 0 then any($own[]; .step != 7)
        else (issue($b.ticket).state // $b.state) != "CLOSED" end;
    def held($s): [$s | select(.step == 0) | .state | gsub("PR #[0-9]+"; "") | scan(TICKET)];
    def blockers($e; $s):
      ((issue($e.ticket).blockers // []) + ($e.inherited // [])) as $github
      | held($s) as $held
      | ([$e.blocked // [] | .[] | {ticket: .}] + $github + [$held[] | {ticket: .}] | distinct(.ticket) | map(select(.ticket != $e.ticket)))
      | map(. as $b | {ticket, open: still_open($b),
          arrow: (any($github[]; .ticket == $b.ticket) or ($b.ticket | startswith("#") and any($held[]; . == $b.ticket)))});
    def item($e; $s):
      blockers($e; $s) as $b
      | [$b[] | select(.open) | .ticket] as $waiting
      | {ticket: ($s.ticket // $e.ticket), base: ($s.base // $e.ticket), parent: ($e.parent // (if $s.parent != $e.ticket then $s.parent else null end)), rule: (issue($e.ticket) | .rule // .title),
         state: ($s.state // (if ($waiting | length) > 0 then "espera " + ($waiting | join(", ")) else "Na fila" end)),
         step: ($s.step // "—"), executor: ($s.executor // "—"), model: ($s.model // "—"), points: ($s.points // "—"), blockers: $b};
    {project: $project, date: $m.date,
     stale: (($cache.stale // false) or ($cache.refreshed_at != null and $now - $cache.refreshed_at > $stale_after)),
     refreshed_at: $cache.refreshed_at,
     parents: [$m.items[] | select(.is_parent) | {ticket, leaves}],
     items: ([$tickets[] | . as $e | [$board[] | select(.base == $e.ticket)] as $own
              | if ($own | length) > 0 then $own[] | item($e; .) else item($e; null) end]
             + [$unlisted[] | item({ticket: .base, parent: .parent}; .)])}'

age() {
  local s=$(( $1 ))
  if [ "$s" -lt 0 ]; then s=0; fi
  if [ "$s" -lt 60 ]; then echo "${s}s"
  elif [ "$s" -lt 3600 ]; then echo "$((s / 60))m"
  elif [ "$s" -lt 86400 ]; then echo "$((s / 3600))h"
  else echo "$((s / 86400))d"; fi
}

if [ -t 1 ]; then
  OFF=$'\e[0m' BOLD=$'\e[1m' DIM=$'\e[2m' RED=$'\e[38;5;203m' YEL=$'\e[38;5;221m' GRN=$'\e[38;5;114m' BLU=$'\e[38;5;75m' GRY=$'\e[38;5;244m'
else
  OFF='' BOLD='' DIM='' RED='' YEL='' GRN='' BLU='' GRY=''
fi

repeat() { local i; for ((i = 0; i < $2; i++)); do printf '%s' "$1"; done; }

pad() { printf '%s' "$1"; repeat ' ' $(($2 - ${#1})); }

num() { if [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then printf '%.0f' "$1"; else echo '?'; fi; }

bar() {
  local p="$1" width="$2" colour="$GRN" filled=0
  if [ "$p" = '?' ]; then
    printf '%s' "$GRY"; repeat '░' "$width"; printf '%s' "$OFF"
    return
  fi
  [ "$p" -gt 100 ] && p=100
  [ "$p" -ge 50 ] && colour="$YEL"
  [ "$p" -ge 80 ] && colour="$RED"
  filled=$((p * width / 100))
  if [ "$p" -gt 0 ] && [ "$filled" -eq 0 ]; then filled=1; fi
  printf '%s' "$colour"; repeat '█' "$filled"
  printf '%s' "$GRY"; repeat '░' $((width - filled)); printf '%s' "$OFF"
}

meter() {
  local p='?'
  [ "$1" != - ] && p=$(num "$1")
  printf '%s %3s' "$(bar "$p" "$2")" "$p$([ "$p" != '?' ] && echo '%')"
}

renewal() {
  local at="$1" now="$2" text=''
  if [ "$at" != - ] && [ "$at" -gt 0 ] 2>/dev/null; then
    if [ "$at" -le "$now" ]; then text='renovou'
    elif [ $((at - now)) -lt 86400 ]; then text="↻ $(date -d "@$at" +%H:%M)"
    else text="↻ $(date -d "@$at" +%d/%m)"; fi
  fi
  pad "$text" 7
}

JOINED='map(tostring | gsub("[\n\u001f]"; " ")) | join("\u001f")'

fields() {
  local f out=()
  for f; do out+=("${f//[$'\037\n']/$'\t'}"); done
  (IFS=$'\037'; printf '%s\n' "${out[*]}")
}

model_name() {
  local name=${1//[\"\']/}
  [[ "$name" =~ ^[A-Za-z0-9._:/@-]+(\[[0-9A-Za-z]+\])?$ ]] && echo "$name"
}

epoch() {
  if [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]]; then date -d "$1" +%s 2>/dev/null || echo -; else echo -; fi
}

limit_rows() {
  local now f name a h d r w
  now=$(date +%s)
  shopt -s dotglob nullglob
  local files=("$state"/*.json)
  [ "${#files[@]}" -gt 0 ] || fields claude - - - - - - -
  for f in "${files[@]}"; do
    name=$(basename "$f" .json); name=${name#.}
    if jq -e . "$f" >/dev/null 2>&1; then
      IFS=$'\037' read -r a h d r w <<<"$(jq -r '[.updated_at // "-", .five_hour.used_percentage // "-", .seven_day.used_percentage // "-", .five_hour.resets_at // "-", .seven_day.resets_at // "-"] | '"$JOINED" "$f")"
      fields "$name" "$h" "$d" "$a" "$r" "$a" "$r" "$w"
    else
      fields "$name" - - - - - - -
    fi
  done
  local line at ts shown
  line=$(jq -r 'def window($ring): first(.meters[0].windows[]? | select(.ring == $ring)) // {};
    .providers[]? | select(.id == "codex")
    | [.lastSuccessAt // "-",
       (window("session").usedPercent // "-"),
       (window("weekly").usedPercent // "-"),
       (window("session").resetsAt // "-"),
       (window("weekly").resetsAt // "-")] | '"$JOINED" "$data/usage/providers/.status.json" 2>/dev/null)
  if [ -n "$line" ]; then
    IFS=$'\037' read -r at h d r w <<<"$line"
    ts=$(date -d "$at" +%s 2>/dev/null) || ts=-
    shown=$(date -d "$r" +%s 2>/dev/null) || shown=-
    fields codex "$h" "$d" "$ts" "$shown" "$(epoch "$at")" "$(epoch "$r")" "$(epoch "$w")"
  else
    fields codex - - - - - - -
  fi
}

header() {
  local now rows w=0 width=16 name h d a r seen
  now=$(date +%s)
  [ "$cols" -lt 90 ] && width=8
  mapfile -t rows < <(limit_rows | cut -d$'\037' -f1-5)
  for seen in "${rows[@]}"; do
    name=${seen%%$'\037'*}
    [ "${#name}" -gt "$w" ] && w=${#name}
  done
  for seen in "${rows[@]}"; do
    IFS=$'\037' read -r name h d a r <<<"$seen"
    seen='?'
    [[ "$a" =~ ^[0-9]+$ ]] && seen=$(age $((now - a)))
    printf '  %s %s5h%s %s  %s%s  %s%s   %s7d%s %s\n' "$(pad "$name" "$w")" "$DIM" "$OFF" "$(meter "$h" "$width")" \
      "$DIM" "$(renewal "$r" "$now")" "$(pad "$seen" 3)" "$OFF" "$DIM" "$OFF" "$(meter "$d" "$width")"
  done
}

pending_question() {
  tail -n 400 "$1" 2>/dev/null | jq -R 'fromjson? // empty' | jq -s -r '
    ([.[] | select(.type == "assistant")] | last) as $last
    | ([.[] | .message.content?[]? | select(.type == "tool_result") | .tool_use_id]) as $done
    | if $last == null then "no"
      elif ([$last.message.content[]? | select(.type == "tool_use" and .name == "AskUserQuestion" and ((.id) as $i | $done | index($i) | not))] | length) > 0
      then "yes" else "no" end' 2>/dev/null
}

last_model() {
  tail -n 400 "$1" 2>/dev/null | jq -R 'fromjson? // empty' | jq -s -r '[.[] | select(.type == "assistant" and .message.model != null) | .message.model] | last // empty' 2>/dev/null
}

context_tokens() {
  tail -n 400 "$1" 2>/dev/null | jq -R 'fromjson? // empty' | jq -s -r '
    [.[] | select(.type == "assistant" and .message.usage != null) | .message.usage] | last
    | if . == null then "" else (.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0) end' 2>/dev/null
}

find_session() {
  local cwd="$1" dir f best="" best_at=-1 at pid
  local IFS=:
  for dir in $claude_dirs${2:+:$2}; do
    for f in "$dir"/sessions/*.json; do
      [ -f "$f" ] || continue
      IFS=' ' read -r at pid <<<"$(jq -r --arg cwd "$cwd" 'select(.cwd == $cwd) | "\(.statusUpdatedAt // 0) \(.pid // 0)"' "$f" 2>/dev/null)"
      [ -n "$at" ] || continue
      kill -0 "$pid" 2>/dev/null || continue
      if [ "$at" -gt "$best_at" ] 2>/dev/null; then best_at=$at; best="$dir|$f"; fi
    done
  done
  echo "$best"
}

find_rollout() {
  local f
  while IFS= read -r f; do
    [ "$(head -n 1 "$f" | jq -r 'select(.type == "session_meta" and (.payload.thread_source // "user") == "user") | .payload.cwd // empty' 2>/dev/null)" = "$1" ] && { echo "$f"; return; }
  done < <(find "$codex_dir" -name 'rollout-*.jsonl' -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)
}

rollout_field() {
  grep -F "\"$1\"" "$2" | jq -R 'fromjson? // empty' | jq -s -r "$3" 2>/dev/null
}

procs_map() {
  local e rec comm id readable=no
  for e in "$proc_dir"/[0-9]*/environ; do
    [ -r "$e" ] && { readable=yes; break; }
  done
  [ "$readable" = yes ] || return 1
  while IFS= read -r -d '' rec; do
    id=${rec#*/environ:MAESTRI_TERMINAL_ID=}
    [ -n "$id" ] || continue
    comm=''
    read -r comm 2>/dev/null <"${rec%%/environ:*}/comm"
    procs[$id]+="$comm"$'\n'
  done < <(grep -azH '^MAESTRI_TERMINAL_ID=' "$proc_dir"/[0-9]*/environ 2>/dev/null)
}

command_word() {
  local ws w
  read -ra ws <<<"$1"
  for w in "${ws[@]}"; do
    [ "$w" = env ] && continue
    [[ "$w" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && continue
    w=${w##*/}
    echo "${w:0:15}"
    return
  done
}

agent_kind() {
  local own comm kind='' want=''
  own=$(command_word "$2")
  case "$3" in claude_code) want=claude ;; codex) want=codex ;; esac
  while IFS= read -r comm; do
    case "$comm" in
      '') ;;
      "$want") echo "$comm"; return ;;
      claude|codex) kind=${kind:-$comm} ;;
      sh|bash|zsh|dash|fish) ;;
      "$own") kind=${kind:-other} ;;
    esac
  done <<<"${procs[$1]:-}"
  echo "$kind"
}

translate() {
  sed -e 's/^implementing/implementando/' -e 's/^reviewing/revisando/' -e 's/^merged/mergeado/' \
      -e 's/^held behind/aguardando/' -e 's/^PR open/PR aberto/' -e 's/^recon/reconhecimento/' <<<"$1"
}

board_step() {
  case "$1" in
    '?') echo '?' ;;
    -) echo - ;;
    'held behind'*) echo 0 ;;
    recon*|grilling*) echo 1 ;;
    implementing*) echo 2 ;;
    reviewing*) echo 3 ;;
    'PR open'*) echo 4 ;;
    CI*) echo 5 ;;
    verified*|'waiting Jonatas'*) echo 6 ;;
    merged*) echo 7 ;;
    *) echo '?' ;;
  esac
}

agent_status() {
  local bstate="$1" star="$2" session="$3" live="$4"
  case "$bstate" in merged*) echo done; return ;; esac
  if [ "$star" = '!' ]; then echo needs; return; fi
  case "$bstate" in
    'waiting Jonatas'*) echo needs; return ;;
    reviewing*|'PR open'*|CI*|verified*) echo review; return ;;
    'held behind'*) echo blocked; return ;;
    -|'?') [ "$session" = idle ] && { echo stopped; return; } ;;
  esac
  if [ "$live" = yes ]; then echo running; else echo '?'; fi
}

parent_slices() {
  [ -f "$1" ] || { echo -; return; }
  awk -F' · ' '
    { for (i = 1; i <= 2; i++) if ($i ~ /^[^ \/]*(#[0-9]+|[A-Z]+-[0-9]+)\/[^ \/]+$/) {
        p = $i; sub(/\/.*/, "", p)
        if (!(p in total)) order[++n] = p
        total[p]++
        if ($(i + 1) ~ /^merged/) merged[p]++
        break
      } }
    END {
      if (!n) printf "-"
      for (i = 1; i <= n; i++) printf "%s%s=%d/%d", (i > 1 ? "," : ""), order[i], merged[order[i]], total[order[i]]
    }' "$1"
}

agent_row() {
  local project="$1" ws="$2" name="$3" type="$4" cmd="$5" role="$6" cwd="$7" found="$8" roles="$9" rollout="${10}"
  local now model rolename ticket tstate points foryou since ctx star bstate board_ticket step slices session=- live=no context='?'
  now=$(date +%s)
  model=$(model_name "$(sed -n 's/.*--model[ =]\([^ ]*\).*/\1/p' <<<"$cmd")")
  rolename=$(jq -r --arg r "$(tr 'A-Z' 'a-z' <<<"$role")" '.payload.rolePresets[]? | select((.id | ascii_downcase) == $r) | .name' "$roles" 2>/dev/null | head -1)
  [ -n "$rolename" ] || rolename='?'

  ticket='?'; tstate='?'; points='?'
  local board="$ws/notes/board.md"
  if [ -f "$board" ]; then
    ticket='-'; tstate='-'; points='-'
    local l
    l=$(awk -F' · ' -v n="$name" '$1 == n { print; exit }' "$board")
    if [ -n "$l" ]; then
      IFS='|' read -r ticket tstate points <<<"$(awk -F' · ' '{ printf "%s|%s|%s", $2, $3, ($5 == "" ? "?" : $5) }' <<<"$l")"
      ticket=${ticket##*/}
      bstate=$tstate
      tstate=$(translate "$tstate")
    fi
  fi
  bstate=${bstate:-$tstate}
  board_ticket=$ticket
  step=$(board_step "$bstate")
  slices=$(parent_slices "$board")

  foryou='?'
  [ -f "$ws/notes/for you.md" ] && foryou=$(grep -c -- '^- \[ \]' "$ws/notes/for you.md")

  since='?'; ctx='?'; star='-'
  if [ -n "$found" ]; then
    local dir sf sid tr tokens size account at status last
    dir=${found%%|*}; sf=${found#*|}
    live=yes
    IFS=$'\037' read -r at status sid <<<"$(jq -r '[.statusUpdatedAt // "-", .status // "-", .sessionId // "-"] | '"$JOINED" "$sf" 2>/dev/null)"
    [[ "$at" =~ ^[0-9]+$ ]] && since=$(age $((now - at / 1000)))
    session=$status
    case "$tstate/$status" in
      [-?]/busy) tstate='trabalhando' ;;
      [-?]/idle) tstate='parado' ;;
      [-?]/shell) tstate='rodando comando' ;;
      [-?]/waiting) tstate='esperando resposta' ;;
    esac
    [ "$status" = waiting ] && star='!'
    tr="$dir/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$cwd")/$sid.jsonl"
    if [ -f "$tr" ]; then
      tokens=$(context_tokens "$tr")
      last=$(last_model "$tr")
      account=$(basename "$dir")
      size=$(jq -r --arg m "$last" '.context_window_sizes[$m] // empty' "$state/$account.json" 2>/dev/null)
      [ -n "$tokens" ] && [ -n "$size" ] && ctx=$(awk -v t="$tokens" -v s="$size" 'BEGIN { printf "%.0f", t * 100 / s }')
      [ "$tokens" -gt 0 ] 2>/dev/null && [ "$size" -gt 0 ] 2>/dev/null && context=$ctx
      [ "$(pending_question "$tr")" = yes ] && star='!'
      [ -n "$model" ] || model=$(model_name "$(sed -e 's/^claude-//' -e 's/-[0-9].*//' <<<"$last")")
    fi
  fi
  if [ -n "$rollout" ]; then
    local rtokens rwindow rmtime
    rmtime=$(stat -c %Y "$rollout" 2>/dev/null)
    [[ "$rmtime" =~ ^[0-9]+$ ]] && since=$(age $((now - rmtime)))
    [ -n "$model" ] || model=$(model_name "$(rollout_field turn_context "$rollout" '[.[] | select(.type == "turn_context") | .payload.model] | last // empty')")
    IFS=' ' read -r rtokens rwindow <<<"$(rollout_field token_count "$rollout" '[.[] | select(.payload.type? == "token_count" and .payload.info != null) | .payload.info] | last // empty | "\(.last_token_usage.input_tokens // 0) \(.model_context_window // 0)"')"
    if [ "$rtokens" -gt 0 ] 2>/dev/null && [ "$rwindow" -gt 0 ] 2>/dev/null; then
      ctx=$(awk -v t="$rtokens" -v s="$rwindow" 'BEGIN { printf "%.0f", t * 100 / s }')
      context=$ctx
    fi
  fi
  [ -n "$model" ] || model='?'
  [ "$type" = claude_code ] || live=yes
  if [ "$ticket" = - ] || [ "$ticket" = '?' ]; then
    case "$rolename" in Executor|'?') ;; *) ticket="$rolename" ;; esac
  fi

  fields "$project" "$name" "$model" "$ticket" "$tstate" "$points" "$since" "$ctx" "$star" "$foryou" \
    "$rolename" "$board_ticket" "$step" "$(agent_status "$bstate" "$star" "$session" "$live")" "$slices" "$context"
}

any_session() {
  local dir f IFS=:
  for dir in $claude_dirs; do
    for f in "$dir"/sessions/*.json; do
      [ -f "$f" ] && return 0
    done
  done
  return 1
}

rows() {
  local roles="$data/preferences.json" w sessions=no mapped=no
  any_session && sessions=yes
  procs_map && mapped=yes
  for w in "$data"/workspaces/*/; do
    [ -f "$w/workspace.json" ] || continue
    w=${w%/}
    local list
    if ! list=$(jq -r 'def dash: if . == null or . == "" then "-" else . end;
        .payload as $p | $p.nodes[]? | .content.terminal._0? // empty
        | select(.agentType != null and .agentType != "generic_shell")
        | [($p.name | dash), .name, .agentType, (.command | dash), (.assignedRoleId | dash),
           ((.workingDirectory | dash) as $d | if $d == "-" then ($p.workingDirectory | dash) else $d end),
           (.status | dash), (.id | dash)] | @tsv' "$w/workspace.json" 2>/dev/null); then
      fields '?' '?' '?' '?' '?' '?' '?' '?' - '?' '?' '?' '?' '?' - '?'
      continue
    fi
    local project name type cmd role wd status id cwd found rollout kind
    while IFS=$'\t' read -r project name type cmd role wd status id; do
      [ -n "$name" ] || continue
      wd=${wd%/}
      cwd=$wd
      [ "$role" = - ] || cwd="$wd/.maestri/roles/$(tr 'A-Z' 'a-z' <<<"$role")"
      found=''; rollout=''
      if [ "$mapped" = yes ]; then
        kind=$(agent_kind "$id" "$cmd" "$type")
        [ -n "$kind" ] || continue
        case "$kind/$type" in
          claude/claude_code|claude/custom) found=$(find_session "$cwd" "$(sed -n 's/.*CLAUDE_CONFIG_DIR=\([^ ]*\).*/\1/p' <<<"$cmd" | head -1)") ;;
          codex/*) rollout=$(find_rollout "$cwd") ;;
        esac
      else
        [ "$type" = claude_code ] && found=$(find_session "$cwd")
        if [ -z "$found" ]; then
          [ "$status" = running ] || continue
          [ "$type" != claude_code ] || [ "$sessions" = no ] || continue
        fi
      fi
      agent_row "$project" "$w" "$name" "$type" "$cmd" "$role" "$cwd" "$found" "$roles" "$rollout"
    done <<<"$list"
  done
}

state_mark() {
  case "$1/$2" in
    '!'/*) printf '%s!%s' "$RED" "$OFF" ;;
    */mergeado*|*/closed*|*/done*) printf '%s✓%s' "$GRY" "$OFF" ;;
    */revisando*) printf '%s◐%s' "$YEL" "$OFF" ;;
    */aguardando*|*/parado*) printf '%s○%s' "$GRY" "$OFF" ;;
    *'/?') printf '?' ;;
    *) printf '%s●%s' "$GRN" "$OFF" ;;
  esac
}

render() {
  local all=() line project name model ticket tstate points since ctx star foryou
  local -A hot=() open=() seen=()
  local wn=5 wm=5 wt=6 ws=6 wp=0 pending=0 agents=0
  mapfile -t all < <(rows | tr '\037' '\t' | cut -f1-10)
  for line in "${all[@]}"; do
    IFS=$'\t' read -r project name model ticket tstate points since ctx star foryou <<<"$line"
    [ "$name" = '?' ] || agents=$((agents + 1))
    [ "$star" = '!' ] && { hot[$project]=1; pending=$((pending + 1)); }
    if [ -z "${open[$project]:-}" ]; then
      open[$project]=$foryou
      [ "$foryou" = '?' ] || pending=$((pending + foryou))
    fi
    [ "${#name}" -gt "$wn" ] && wn=${#name}
    [ "${#model}" -gt "$wm" ] && wm=${#model}
    [ "${#ticket}" -gt "$wt" ] && wt=${#ticket}
    [ "${#tstate}" -gt "$ws" ] && ws=${#tstate}
    case "$points" in [0-9]*) [ "${#points}" -gt "$wp" ] && wp=${#points} ;; esac
  done
  local fixed=$((2 + 1 + 2 + wn + 2 + wm + 2 + wt + 2 + 2 + 4 + 2 + 8 + 1 + 4))
  [ "$wp" -gt 0 ] && fixed=$((fixed + wp + 2))
  local room=$((cols - fixed))
  [ "$room" -lt 8 ] && room=8
  [ "$ws" -gt "$room" ] && ws=$room
  local total=$((fixed + ws))

  printf '\n  %sCOCKPIT%s  %s%s · %s · %s%s\n\n' "$BOLD" "$OFF" "$DIM" "$(date +%H:%M)" \
    "$agents agente$([ "$agents" = 1 ] || echo s)" \
    "$pending pendência$([ "$pending" = 1 ] || echo s)" "$OFF"
  header
  echo

  local turn order=()
  for turn in hot rest; do
    for line in "${all[@]}"; do
      project=${line%%$'\t'*}
      [ -n "${seen[$project]:-}" ] && continue
      if [ "$turn" = rest ] || [ -n "${hot[$project]:-}" ]; then
        seen[$project]=1
        order+=("$project")
      fi
    done
  done

  local p heading rule mark want
  for p in "${order[@]}"; do
    heading=''
    [ "${open[$p]}" = 0 ] || heading=" ${open[$p]} em for you"
    rule=$((total - 2 - ${#p} - 1 - ${#heading}))
    [ "$rule" -lt 3 ] && rule=3
    printf '  %s%s%s%s %s%s%s%s\n' "$BOLD" "$BLU" "$p" "$OFF" "$GRY" "$(repeat '─' "$rule")" "$OFF" "$heading"
    for want in '!' '-'; do
      for line in "${all[@]}"; do
        IFS=$'\t' read -r project name model ticket tstate points since ctx star foryou <<<"$line"
        [ "$project" = "$p" ] && [ "$star" = "$want" ] || continue
        [ "${#tstate}" -gt "$ws" ] && tstate="${tstate:0:$((ws - 1))}…"
        mark=$(state_mark "$star" "$tstate")
        local fade=''
        case "$tstate" in mergeado*|closed*|done*) fade="$DIM" ;; esac
        printf '  %s  %s%s%s  %s%s%s  %s  %s%s%s' "$mark" "$fade" "$(pad "$name" "$wn")" "$OFF" \
          "$DIM" "$(pad "$model" "$wm")" "$OFF" "$(pad "$ticket" "$wt")" "$fade" "$(pad "$tstate" "$ws")" "$OFF"
        [ "$wp" -gt 0 ] && printf '  %s' "$(pad "$points" "$wp")"
        printf '  %s%4s%s  %s\n' "$DIM" "$since" "$OFF" "$(meter "$([ "$ctx" = '?' ] && echo - || echo "$ctx")" 8)"
      done
    done
    echo
  done
  printf '  %s● ativo  ◐ revisão  ○ parado  ✓ terminou  ! precisa de você%s\n' "$DIM" "$OFF"
}

limit_snapshot() {
  local now name h d r w a seen
  now=$(date +%s)
  limit_rows | while IFS=$'\037' read -r name h d _ _ a r w; do
    seen='?'
    [[ "$a" =~ ^[0-9]+$ ]] && seen=$(age $((now - a)))
    fields "$name" "$(num "$h")" "$r" "$(num "$d")" "$w" "$a" "$seen"
  done
}

round_state() {
  case "$1" in
    'held behind '*) echo "espera ${1#held behind }" ;;
    *) translate "$1" ;;
  esac
}

round_slices() {
  [ -f "$1" ] || return
  local code ticket bstate model points
  while IFS=$'\037' read -r code ticket bstate model points; do
    fields "$code" "$ticket" "$(round_state "$bstate")" "$model" "${points:-?}" "$(board_step "$bstate")"
  done < <(awk -F' · ' -v OFS=$'\037' '
    function is_ticket(f) { return f ~ /^(#[0-9]+|[A-Z]+-[0-9]+)([ \/].*)?$/ }
    /^# / || /^testes · / || /^merge:/ { next }
    NF >= 3 && is_ticket($2) { print $1, $2, $3, $4, $5; next }
    NF >= 2 && is_ticket($1) { print "—", $1, $2, $3, $4 }' "$1")
}

round_cache() {
  [ -f "$1" ] || return
  jq -ce 'objects' "$1" 2>/dev/null || echo '{"stale":true}'
}

rounds() {
  local w project
  for w in "$data"/workspaces/*/; do
    w=${w%/}
    [ -f "$w/workspace.json" ] && [ -f "$w/notes/round.md" ] || continue
    project=$(jq -r '.payload.name // "?"' "$w/workspace.json" 2>/dev/null)
    jq -nc --argjson now "$(date +%s)" --argjson stale_after "$ROUND_STALE_SECONDS" --arg project "$project" --rawfile note "$w/notes/round.md" \
      --rawfile lines <(round_slices "$w/notes/board.md") --slurpfile cached <(round_cache "$rounds_dir/${w##*/}.json") "$ROUND" 2>/dev/null
  done
}

github_repo() {
  local remote url
  for remote in origin $(git -C "$1" remote 2>/dev/null); do
    url=$(git -C "$1" remote get-url "$remote" 2>/dev/null) || continue
    if [[ "$url" =~ ^(https://([^@/]+@)?github\.com/|git@github\.com:|ssh://git@github\.com/)([^/]+)/([^/]+)$ ]]; then
      echo "${BASH_REMATCH[3]}/${BASH_REMATCH[4]%.git}"
      return
    fi
  done
  return 1
}

ISSUE_FIELDS='number title body state repository { nameWithOwner } blockedBy(first: 50) { nodes { number state repository { nameWithOwner } } }'
ISSUE_QUERY="query(\$owner: String!, \$name: String!, \$number: Int!) { repository(owner: \$owner, name: \$name) { issue(number: \$number) { $ISSUE_FIELDS subIssues(first: 50) { nodes { $ISSUE_FIELDS } } } } }"
CACHE='
def ref($home): if .repository.nameWithOwner == $home then "#\(.number)" else "\(.repository.nameWithOwner)#\(.number)" end;
def record($home): {key: ref($home), value: {title, state,
  rule: ([(.body // "") | gsub("\r"; "") | split("\n")[] | capture("^\\s*\\*\\*Rule:\\*\\*\\s*(?<r>.+)$").r][0]),
  leaves: [.subIssues.nodes[]? | ref($home)],
  blockers: [.blockedBy.nodes[]? | {ticket: ref($home), state}]}};
[.[].data.repository.issue | objects] as $found
| ([$found[] | .repository.nameWithOwner as $home | .subIssues.nodes[]? | record($home)]
   + [$found[] | record(.repository.nameWithOwner)] | from_entries) as $fresh
| ($old[0] // {}) as $last
| if $failed then $last + {stale: true, issues: (($last.issues // {}) + $fresh)}
  else {refreshed_at: $now, stale: false, issues: $fresh} end'

refresh_round() {
  local id="$1" repo="$2" numbers="$3" n answer answers='' failed=false tmp
  for n in $numbers; do
    answer=$(timeout --foreground 15 gh api graphql -f query="$ISSUE_QUERY" -f owner="${repo%/*}" -f name="${repo#*/}" -F number="$n" 2>/dev/null)
    if jq -e '.data.repository | has("issue")' <<<"$answer" >/dev/null 2>&1; then
      answers+=$answer$'\n'
    else
      failed=true
      break
    fi
  done
  mkdir -p "$rounds_dir"
  tmp=$(mktemp "$rounds_dir/.XXXXXX")
  if jq -s --argjson now "$(date +%s)" --argjson failed "$failed" --slurpfile old <(round_cache "$rounds_dir/$id.json") "$CACHE" <<<"$answers" > "$tmp"; then
    mv "$tmp" "$rounds_dir/$id.json"
  else
    rm -f "$tmp"
  fi
}

refresh_rounds() {
  local w repo numbers
  for w in "$data"/workspaces/*/; do
    w=${w%/}
    [ -f "$w/workspace.json" ] && [ -f "$w/notes/round.md" ] || continue
    repo=$(github_repo "$(jq -r '.payload.workingDirectory // ""' "$w/workspace.json" 2>/dev/null)") || continue
    numbers=$(jq -Rrs "$MANIFEST"'manifest // empty | [.items[] | .ticket, .blocked[]] | unique[] | select(startswith("#")) | ltrimstr("#")' "$w/notes/round.md" 2>/dev/null)
    [ -n "$numbers" ] && refresh_round "${w##*/}" "$repo" "$numbers"
  done
}

snapshot() {
  jq -n --argjson now "$(date +%s)" --rawfile limits <(limit_snapshot) --rawfile agents <(rows) --slurpfile rounds <(rounds) "$KNOWN"'
    def lines: split("\n") | map(select(. != "") | split("\u001f"));
    def stamp: if test("^[1-9][0-9]*$") then tonumber else "?" end;
    def slices: if . == null or . == "-" then [] else split(",") | map(capture("^(?<parent>.*)=(?<merged>[0-9]+)/(?<total>[0-9]+)$")
      | {parent, merged: (.merged | tonumber), total: (.total | tonumber)}) end;
    ($agents | lines | map({project: .[0], for_you: (.[9] | known), slices: (.[14] | slices), question: (.[8] == "!"),
      agent: {name: .[1], model: .[2], role: (.[10] | known), ticket: (.[11] | known), points: (.[5] | known),
        status: (.[13] | known), status_text: (.[4] | known), since: .[6], context: (.[15] | known), step: (.[12] | known)}})) as $rows
    | ($rows | group_by(.project) | map({name: .[0].project, for_you: .[0].for_you, slices: .[0].slices, agents: map(.agent)})) as $projects
    | ($rows | map(select(.question and .agent.status != "done")) | length) as $asking
    | ($projects | map(.for_you)) as $open
    | {generated_at: $now,
       limits: ($limits | lines | map({account: .[0],
         five_hour: {used: (.[1] | known), resets_at: (.[2] | stamp)},
         seven_day: {used: (.[3] | known), resets_at: (.[4] | stamp)},
         updated_at: (.[5] | stamp), age: .[6]})),
       pending: {agents: $asking,
         for_you: (if any($open[]; . == "?") then "?" else ($open | add // 0) end),
         total: (if any($open[]; . == "?") then "?" else $asking + ($open | add // 0) end)},
       projects: $projects,
       rounds: ($rounds | sort_by(.project))}'
}

terminal_width() {
  local w
  w=${COLUMNS:-$({ stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2)}
  echo "${w:-100}"
}

cols=$(terminal_width)

if [ "${1:-}" = "--once" ]; then
  render
  exit 0
fi

if [ "${1:-}" = "--json" ]; then
  snapshot
  exit
fi

if [ "${1:-}" = "--refresh-rounds" ]; then
  refresh_rounds
  exit 0
fi

if [ "${1:-}" = "--serve" ]; then
  command -v python3 >/dev/null || { echo "cockpit: --serve needs python3" >&2; exit 1; }
  exec python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/cockpit-serve" "${2:-4317}"
fi

while true; do
  cols=$(terminal_width)
  out=$(render)
  printf '\033[H\033[2J%s\n' "$out"
  sleep 5
done
