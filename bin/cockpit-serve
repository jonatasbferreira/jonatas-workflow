#!/usr/bin/env python3
import json
import os
import re
import signal
import subprocess
import sys
import threading
from concurrent.futures import Future
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

BIN = Path(__file__).resolve().parent
PAGE = BIN.parent / "templates" / "cockpit.html"
SNAPSHOT_SECONDS = 20
HOST = re.compile(r"(localhost|127\.0\.0\.1)(:[0-9]+)?")
ORIGIN = re.compile(r"https?://(localhost|127\.0\.0\.1)(:[0-9]+)?")


class Snapshots:
    def __init__(self):
        self.lock = threading.Lock()
        self.running = None
        self.process = None

    def take(self):
        with self.lock:
            leader = self.running is None
            if leader:
                self.running = Future()
            running = self.running
        if leader:
            body = None
            try:
                body = self.collect()
            finally:
                with self.lock:
                    self.running = None
                running.set_result(body)
        return running.result()

    def collect(self):
        self.process = subprocess.Popen([BIN / "cockpit", "--json"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
        try:
            body, _ = self.process.communicate(timeout=SNAPSHOT_SECONDS)
            json.loads(body)
            return body if self.process.returncode == 0 else None
        except (subprocess.TimeoutExpired, ValueError):
            self.kill()
            self.process.wait()
            return None
        finally:
            self.process = None

    def kill(self):
        if self.process:
            try:
                os.killpg(self.process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass


snapshots = Snapshots()


class Cockpit(BaseHTTPRequestHandler):
    def parse_request(self):
        if not super().parse_request():
            return False
        hosts = self.headers.get_all("Host") or []
        origins = self.headers.get_all("Origin") or []
        if len(hosts) != 1 or not HOST.fullmatch(hosts[0]) or not all(ORIGIN.fullmatch(origin) for origin in origins):
            self.send_error(403)
            return False
        return True

    def do_GET(self):
        if self.path == "/":
            self.answer("text/html; charset=utf-8", PAGE.read_bytes())
        elif self.path == "/snapshot":
            self.answer_snapshot()
        else:
            self.send_error(404)

    def answer_snapshot(self):
        body = snapshots.take()
        if body is None:
            self.send_error(500)
            return
        self.answer("application/json", body)

    def answer(self, kind, body):
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        pass


def main():
    port = sys.argv[1]
    if not re.fullmatch(r"[0-9]+", port) or not 1 <= int(port) <= 65535:
        sys.exit(f"cockpit: {port} is not a port")
    try:
        server = ThreadingHTTPServer(("127.0.0.1", int(port)), Cockpit)
    except OSError as error:
        sys.exit(f"cockpit: cannot listen on 127.0.0.1:{port}: {error.strerror}")
    for stop in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(stop, lambda *_: sys.exit(0))
    print(f"Cockpit at http://127.0.0.1:{port}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        snapshots.kill()


main()
