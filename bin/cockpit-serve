#!/usr/bin/env python3
import json
import re
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

BIN = Path(__file__).resolve().parent
PAGE = BIN.parent / "templates" / "cockpit.html"
HOST = re.compile(r"(localhost|127\.0\.0\.1)(:[0-9]+)?")


class Cockpit(BaseHTTPRequestHandler):
    def parse_request(self):
        if not super().parse_request():
            return False
        hosts = self.headers.get_all("Host") or []
        if len(hosts) != 1 or not HOST.fullmatch(hosts[0]):
            self.send_error(403)
            return False
        return True

    def do_GET(self):
        if self.path == "/":
            self.answer("text/html; charset=utf-8", PAGE.read_bytes())
        elif self.path == "/snapshot":
            self.snapshot()
        else:
            self.send_error(404)

    def snapshot(self):
        run = subprocess.run([BIN / "cockpit", "--json"], capture_output=True)
        try:
            if run.returncode != 0:
                raise ValueError
            json.loads(run.stdout)
        except ValueError:
            self.send_error(500)
            return
        self.answer("application/json", run.stdout)

    def answer(self, kind, body):
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format, *args):
        pass


def main():
    port = sys.argv[1]
    if not re.fullmatch(r"[0-9]+", port) or not 1 <= int(port) <= 65535:
        sys.exit(f"cockpit: {port} is not a port")
    try:
        server = ThreadingHTTPServer(("127.0.0.1", int(port)), Cockpit)
    except OSError as error:
        sys.exit(f"cockpit: cannot listen on 127.0.0.1:{port}: {error.strerror}")
    print(f"Cockpit at http://127.0.0.1:{port}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


main()
